{
  "expo": {
    "name": "DocuVault",
    "slug": "docuvault",
    "version": "1.0.0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.docuvault.mobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "DocuVault connects to the development API on your local network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.docuvault.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ]
  }
}
